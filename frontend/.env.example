# Файл кладите в КОРЕНЬ репозитория (рядом с docker-compose.yml) — Vite читает оттуда.
# Имя бота без @. В BotFather домен сайта = хост из адресной строки (127.0.0.1 или localhost).
VITE_TELEGRAM_BOT_NAME=YourBotUsername

# Прямой URL бэкенда (не через прокси Vite)
VITE_TELEGRAM_AUTH_URL=http://127.0.0.1:8000/api/auth/telegram
