# ─────────────────────────────────────────────────────────────
# BirthdayPlanner — пример конфигурации. Скопируйте в .env и заполните.
#   cp .env.example .env
# Файл .env в git не коммитится (см. .gitignore).
# ─────────────────────────────────────────────────────────────

# --- Telegram ---
# Токен бота от @BotFather. Обязательно.
BOT_TOKEN=123456789:AA...replace-me
# ID администратора (число). Даёт доступ к /admin и ведёт сценарий группы в ЛС. Необязательно.
TELEGRAM_ADMIN_ID=
# Секрет заголовка вебхука (рекомендуется в проде). Необязательно.
TELEGRAM_WEBHOOK_SECRET=
# Публичный HTTPS-адрес для setWebhook (например https://example.com). Необязательно.
TELEGRAM_WEBHOOK_BASE_URL=

# --- Безопасность / сессии ---
# Длинная случайная строка. Обязательно. Пример: openssl rand -hex 32
JWT_SECRET_KEY=replace-with-a-long-random-string
# true — cookie только по HTTPS (включайте в проде).
COOKIE_SECURE=false
# Разрешённые CORS-origin через запятую. По умолчанию — локальная разработка.
CORS_ALLOW_ORIGINS=http://127.0.0.1,http://localhost,http://127.0.0.1:5173,http://localhost:5173

# --- База данных (Compose соберёт DATABASE_URL из этих значений) ---
DB_USER=postgres
DB_PASSWORD=change-me
DB_NAME=birthday_planner

# --- Сценарий дней рождения ---
# За сколько дней до ДР запускать рассылку.
BIRTHDAY_NOTIFY_DAYS_BEFORE=14
# Часовой пояс ежедневной проверки в 09:00.
SCHEDULER_TIMEZONE=Europe/Moscow

# --- Фронтенд (Vite, во время сборки/запуска) ---
# Имя бота для Telegram Login Widget (без @).
VITE_TELEGRAM_BOT_NAME=YourBotName
# URL бэкенда для редиректа после входа (в Docker задаётся в docker-compose.yml).
VITE_TELEGRAM_AUTH_URL=http://127.0.0.1:8000/api/auth/telegram
